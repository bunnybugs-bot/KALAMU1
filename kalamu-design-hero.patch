+/* ==========================================================================
+   Kalamu — barre de navigation et hero section (style « verre dépoli »)
+   Chargé après styles.css : ces règles remplacent l'ancien en-tête et l'ancienne hero.
+   ========================================================================== */
+:root {
+    --kl-orange: #ff6b35;
+    --kl-orange-2: #f7931e;
+    --kl-ink: #1f2a37;
+    --kl-ink-soft: #5b6573;
+    --kl-glass: rgba(255, 255, 255, 0.72);
+    --kl-glass-strong: rgba(255, 255, 255, 0.9);
+    --kl-glass-border: rgba(255, 255, 255, 0.65);
+    --kl-shadow: 0 8px 32px rgba(31, 42, 55, 0.12);
+    --kl-frame-gap: 12px;
+    --kl-frame-radius: 36px;
+    --kl-font: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+}
+
+/* ------------------------------------------------------------------ Verre */
+.kl-pill,
+.kl-card,
+.kl-rail,
+.kl-round-btn,
+.kl-mobile-menu {
+    background: var(--kl-glass);
+    -webkit-backdrop-filter: blur(18px) saturate(1.4);
+    backdrop-filter: blur(18px) saturate(1.4);
+    border: 1px solid var(--kl-glass-border);
+    box-shadow: var(--kl-shadow);
+}
+
+/* ------------------------------------------------------------------ Barre de navigation */
+header.kl-header {
+    position: fixed;
+    top: 0;
+    left: 0;
+    right: 0;
+    z-index: 100;
+    padding: calc(var(--kl-frame-gap) + 12px) calc(var(--kl-frame-gap) + 16px) 0;
+    background: transparent;
+    border: 0;
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+    pointer-events: none; /* seuls les éléments cliquables captent la souris */
+    font-family: var(--kl-font);
+    transition: padding 0.3s ease;
+}
+
+.kl-header-inner {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem;
+    max-width: 1400px;
+    margin: 0 auto;
+}
+
+.kl-header-inner > * {
+    pointer-events: auto;
+}
+
+.kl-pill {
+    display: inline-flex;
+    align-items: center;
+    height: 56px;
+    border-radius: 999px;
+    color: var(--kl-ink);
+    transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
+}
+
+/* Logo */
+.kl-brand {
+    padding: 0 1.5rem;
+}
+
+.kl-brand img {
+    display: block;
+    height: 36px;
+    width: auto;
+}
+
+/* Liens */
+.kl-nav {
+    padding: 0 0.5rem;
+    gap: 0.25rem;
+}
+
+.kl-nav a {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.5rem;
+    height: 42px;
+    padding: 0 1rem;
+    border-radius: 999px;
+    color: var(--kl-ink);
+    font-size: 0.95rem;
+    font-weight: 500;
+    white-space: nowrap;
+    transition: background 0.2s ease, color 0.2s ease;
+}
+
+.kl-nav a i {
+    font-size: 0.85rem;
+    color: var(--kl-ink-soft);
+    transition: color 0.2s ease;
+}
+
+.kl-nav a:hover {
+    background: rgba(255, 255, 255, 0.85);
+    color: var(--kl-ink);
+}
+
+.kl-nav a.active,
+.kl-nav a[aria-current="page"] {
+    background: var(--kl-ink);
+    color: #fff;
+}
+
+.kl-nav a.active i,
+.kl-nav a[aria-current="page"] i {
+    color: var(--kl-orange-2);
+}
+
+/* Les anciennes règles de styles.css (.main-nav a) ne doivent plus s'appliquer */
+.kl-nav a::after,
+.kl-nav a::before {
+    display: none !important;
+}
+
+/* Bouton d'action */
+.kl-cta {
+    gap: 0.75rem;
+    padding: 0 0.5rem 0 1.5rem;
+    font-weight: 600;
+    font-size: 0.95rem;
+    color: var(--kl-ink);
+}
+
+.kl-cta:hover {
+    color: var(--kl-ink);
+    transform: translateY(-1px);
+}
+
+.kl-arrow {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 40px;
+    height: 40px;
+    border-radius: 50%;
+    background: linear-gradient(135deg, var(--kl-orange), var(--kl-orange-2));
+    color: #fff;
+    font-size: 0.85rem;
+}
+
+.kl-arrow i,
+.kl-round-btn .fa-arrow-right {
+    transform: rotate(-45deg);
+    transition: transform 0.25s ease;
+}
